# ===========================================
# Chat Service - Test Environment
# ===========================================

# Application
NODE_ENV=test
PORT=3006
SERVICE_NAME=chat-service-test

# Database (Test database)
DATABASE_URL="postgresql://user:password@localhost:5432/relationship_app_test?schema=public"

# Redis (Test instance)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=test-jwt-secret-key-for-testing-only
JWT_EXPIRES_IN=1h

# Socket.io Configuration
SOCKET_CORS_ORIGIN=*

# Notification Service (Mock)
NOTIFICATION_SERVICE_URL=http://localhost:3004
NOTIFICATION_SERVICE_API_KEY=test-api-key

# CORE Service (Mock)
CORE_SERVICE_URL=http://localhost:3000
CORE_SERVICE_API_KEY=test-api-key

# Logging
LOG_LEVEL=silent

# Rate Limiting (relaxed for tests)
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=60000
