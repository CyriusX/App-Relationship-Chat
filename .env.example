# ===========================================
# Chat Service - Environment Configuration
# ===========================================
# This service shares the database with CORE and Feed services
# Chat Service has READ-ONLY access to: users, profiles, matches, blocks
# Chat Service has READ-WRITE access to: chat_conversations, chat_messages, etc.

# Application
NODE_ENV=development
PORT=3001
SERVICE_NAME=chat-service

# Database (PostgreSQL - SHARED with CORE and Feed services)
# IMPORTANT: Use the same DATABASE_URL as CORE service
# Chat Service will NOT run migrations - only CORE manages schema
DATABASE_URL="postgresql://user:password@localhost:5432/relationship_app?schema=public"

# Redis (for Socket.io adapter and presence cache)
REDIS_URL="redis://localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration (MUST be same as CORE service for token validation)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Socket.io Configuration
SOCKET_CORS_ORIGIN=http://localhost:3000,http://localhost:19006
SOCKET_PATH=/socket.io

# Service URLs (for inter-service communication)
CORE_SERVICE_URL=http://localhost:3000
FEED_SERVICE_URL=http://localhost:3002
NOTIFICATION_SERVICE_URL=http://localhost:3003

# Internal API Keys (for service-to-service auth)
INTERNAL_API_KEY=your-internal-api-key

# Logging
LOG_LEVEL=debug

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
